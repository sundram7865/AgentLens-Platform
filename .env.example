# ---------------------------------------------------------------------------
# AI Observability & Guardrails Platform -- example environment
#
#   cp .env.example .env
#
# This file is committed. .env is not, ever. Every value below has a working
# default for local development; the production notes say which ones you must
# change and why.
# ---------------------------------------------------------------------------

# -- service ----------------------------------------------------------------
OBS_ENVIRONMENT=local              # local | test | dev | staging | production
OBS_SERVICE_NAME=obs-platform
OBS_LOG_LEVEL=INFO
OBS_LOG_JSON=true                  # false gives human-readable logs locally
PORT=8000

# -- database ---------------------------------------------------------------
# POOLED connection string. Used by the API and every worker.
# Neon: the host with the "-pooler" suffix.
OBS_DATABASE_URL=postgresql+asyncpg://obs:obs@localhost:5432/obs

# DIRECT (un-pooled) connection string. Used by Alembic and nothing else.
# Neon: the same host WITHOUT "-pooler". Leaving this unset makes migrations
# run through PgBouncer, which can strand Alembic's advisory lock and hang.
OBS_DATABASE_DIRECT_URL=postgresql://obs:obs@localhost:5432/obs

OBS_DB_POOL_SIZE=5                 # keep small; Neon free tier and 512 MB boxes
OBS_DB_MAX_OVERFLOW=5

# -- redis / streams --------------------------------------------------------
# Upstash: rediss://default:<password>@<host>:6379
OBS_REDIS_URL=redis://localhost:6379/0
OBS_STREAM=obs:events
OBS_STREAM_MAXLEN=100000           # XADD ... MAXLEN ~ N (approximate trimming)
OBS_CONSUMER_BLOCK_MS=5000         # blocking read: ~1 command per 5s when idle
OBS_CONSUMER_BATCH_SIZE=100
OBS_MAX_DELIVERY_ATTEMPTS=5        # then the message goes to dead_letters

# -- API --------------------------------------------------------------------
OBS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OBS_DOCS_ENABLED=true              # set false in production
OBS_DEFAULT_PAGE_SIZE=25
OBS_MAX_PAGE_SIZE=200

# -- auth -------------------------------------------------------------------
# REQUIRED in production; the app refuses to boot with this dev value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OBS_JWT_SECRET=dev-only-insecure-secret-change-me
OBS_ACCESS_TOKEN_TTL_MINUTES=720

# Created on first boot if absent. Change the password before deploying.
OBS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OBS_BOOTSTRAP_ADMIN_PASSWORD=admin12345

# Optional external OIDC (Keycloak / Auth0 / Clerk). Leave blank to use the
# platform's own JWT auth, which is the default and needs no extra infrastructure.
OBS_OIDC_ISSUER=
OBS_OIDC_JWKS_URL=
OBS_OIDC_AUDIENCE=
OBS_OIDC_ROLE_CLAIM=obs_role

# -- rate limiting ----------------------------------------------------------
OBS_RATE_LIMIT_ENABLED=true
OBS_RATE_LIMIT_REQUESTS=120        # per IP per window
OBS_RATE_LIMIT_WINDOW_SECONDS=60
OBS_RATE_LIMIT_LOGIN_REQUESTS=10   # tighter: login is the credential-stuffing target
OBS_RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# -- guardrails -------------------------------------------------------------
OBS_GUARDRAILS_ENABLED=true
# auto  -> Presidio if installed, else the built-in recognisers
# builtin -> force the built-in engine (~0 MB extra RSS, fits a free-tier box)
OBS_PII_ENGINE=auto
# auto -> sentence-transformers if installed, else the lexical detector
OBS_INJECTION_BACKEND=auto
OBS_INJECTION_THRESHOLD=0.61       # measured, see docs/TUNING.md
OBS_ALERT_SEVERITY_FLOOR=high      # findings at or above this also write an alert

# -- eval scorer ------------------------------------------------------------
OBS_EVALS_ENABLED=true
OBS_EVAL_SAMPLE_RATE=5             # percent, deterministic on hash(trace_id)
OBS_EVAL_BACKEND=auto              # auto | ragas | judge | heuristic
OBS_EVAL_PROVIDER=none             # none | anthropic | openai | google
OBS_EVAL_MODEL=claude-haiku-4-5
OBS_EVAL_API_KEY=                  # ANTHROPIC_API_KEY / OPENAI_API_KEY also read
OBS_EVAL_BATCH_SIZE=10             # batch the judge calls, do not score one by one
OBS_EVAL_BATCH_INTERVAL_SECONDS=30
OBS_EVAL_READY_TIMEOUT_SECONDS=45   # wait this long for the storage writer to
                                    # persist a trace before giving up on scoring
                                    # it. Keep below OBS_CONSUMER_CLAIM_MIN_IDLE_MS
                                    # (default 60s) so a trace reaches a verdict
                                    # before its message is eligible for reclaim.

# -- per-tenant budget cap --------------------------------------------------
# The only recurring cost in the stack. Past the cap the tenant's sample rate
# drops to zero and an alert is written instead of more spend.
OBS_BUDGET_DAILY_USD_PER_TENANT=1.0
OBS_BUDGET_MONTHLY_USD_PER_TENANT=10.0
OBS_BUDGET_DAILY_TOKENS_PER_TENANT=2000000

# -- drift monitor ----------------------------------------------------------
OBS_DRIFT_ENABLED=true
OBS_DRIFT_INTERVAL_SECONDS=300
OBS_DRIFT_WINDOW_HOURS=6
OBS_DRIFT_MIN_SAMPLES=20
OBS_DRIFT_Z_THRESHOLD=2.5
OBS_DRIFT_ABSOLUTE_FLOOR=0.60

# -- retention --------------------------------------------------------------
# Redis is bounded by MAXLEN; nothing bounds Postgres without this.
OBS_RETENTION_DAYS=30
OBS_RETENTION_INTERVAL_SECONDS=3600
OBS_RETENTION_BATCH_SIZE=5000

# -- workers ----------------------------------------------------------------
OBS_WORKER_ROLES=storage,guardrail,eval,scheduler
# Render's free tier has no background-worker service type. Set true to run the
# consumers inside the API process instead of paying for a second service.
OBS_EMBED_WORKERS_IN_API=false
OBS_WORKER_HEARTBEAT_SECONDS=15
OBS_META_HEALTH_MAX_LAG=1000
OBS_META_HEALTH_MAX_WRITE_AGE_SECONDS=900
OBS_RUN_MIGRATIONS=true            # entrypoint runs `alembic upgrade head` first

# ---------------------------------------------------------------------------
# SupportPilot side (set these in SupportPilot's own .env, not here)
# ---------------------------------------------------------------------------
# OBS_ENABLED=true
# OBS_REDIS_URL=<same Redis as above>
# OBS_SERVICE=supportpilot
# OBS_ENVIRONMENT=production
# OBS_CAPTURE_CONTENT=true         # false sends shapes and sizes but no text
